     "id": "d8a6c034",
     "elType": "widget",
     "isInner": false,
     "settings": {
      "html": "<!-- ============================================================================\n  CUMBRE IA NARIÑO · BANNER — vídeo scrubbeado con el mouse, para Elementor.\n\n  CÓMO USARLO:\n  1. En Elementor crea un contenedor con Altura mínima = 100vh y fondo propio\n     (o usa la plantilla cumbre-banner.json ya lista).\n  2. Dentro del contenedor agrega un widget \"HTML\" y pega TODO este archivo.\n  3. En ese mismo contenedor agrega tus widgets de título y texto: el vídeo\n     queda detrás y tus widgets encima, en el orden que quieras.\n  4. Cambia la URL del vídeo en data-video (puede ser un MP4 de tu Biblioteca\n     de medios de WordPress). Debe ser un .mp4 directo H.264 sin audio.\n\n  El efecto: mover el mouse en horizontal adelanta/retrocede el vídeo con\n  suavizado; en pantallas táctiles el vídeo se scrubbea con el scroll; al\n  hacer scroll hacia abajo la escena se funde a oscuro.\n============================================================================ -->\n<div class=\"cumbre-banner\"\n     data-video=\"/cumbre/videos/cumbre-principal.mp4\"\n     data-duracion-reserva=\"4\">\n  <div class=\"cumbre-banner__nucleo\"></div>\n  <div class=\"cumbre-banner__rejilla\"></div>\n  <video class=\"cumbre-banner__video\" muted playsinline preload=\"auto\" aria-hidden=\"true\"></video>\n  <div class=\"cumbre-banner__vineta\"></div>\n  <div class=\"cumbre-banner__salida\"></div>\n</div>\n\n<style>\n  .cumbre-banner{position:absolute;inset:0;overflow:hidden;pointer-events:none;z-index:0;}\n  .cumbre-banner__nucleo{position:absolute;inset:0;\n    background:radial-gradient(ellipse at center,#000a22 0%,#00133d 65%);}\n  .cumbre-banner__rejilla{position:absolute;inset:0;opacity:.6;mix-blend-mode:overlay;\n    background-size:50px 50px;\n    background-image:linear-gradient(to right,rgba(255,255,255,.04) 1px,transparent 1px),\n      linear-gradient(to bottom,rgba(255,255,255,.04) 1px,transparent 1px);}\n  .cumbre-banner__video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;\n    opacity:.95;mix-blend-mode:screen;}\n  .cumbre-banner__vineta{position:absolute;inset:0;opacity:.9;\n    background:linear-gradient(to top,#00133d 0%,transparent 35%,transparent 70%,#00133d 100%);}\n  .cumbre-banner__salida{position:absolute;inset:0;background:#00133d;opacity:0;}\n  /* El contenedor de Elementor que aloja el banner se vuelve el marco del efecto\n     y sus demás widgets quedan por encima del vídeo. */\n  .cumbre-banner-marco{position:relative!important;overflow:hidden;}\n  .cumbre-banner-marco .elementor-widget:not(.cumbre-banner-anfitrion){position:relative;z-index:2;}\n  /* Degradado ámbar→naranja reutilizable para un heading de Elementor:\n     asigna la clase CSS \"cumbre-texto-degradado\" al widget de título. */\n  .cumbre-texto-degradado .elementor-heading-title{\n    background:linear-gradient(90deg,#feb100,#ff6300);\n    -webkit-background-clip:text;background-clip:text;color:transparent;}\n</style>\n\n<script>\n(function () {\n  \"use strict\";\n  var raiz = document.currentScript.previousElementSibling.previousElementSibling;\n  if (!raiz || !raiz.classList || !raiz.classList.contains(\"cumbre-banner\")) {\n    raiz = document.querySelector(\".cumbre-banner:not([data-listo])\");\n  }\n  if (!raiz) return;\n  raiz.setAttribute(\"data-listo\", \"1\");\n\n  var video = raiz.querySelector(\".cumbre-banner__video\");\n  var salida = raiz.querySelector(\".cumbre-banner__salida\");\n  var reserva = parseFloat(raiz.getAttribute(\"data-duracion-reserva\")) || 4;\n  video.src = raiz.getAttribute(\"data-video\");\n\n  // El widget se ancla al contenedor de Elementor que lo aloja.\n  var anfitrion = raiz.closest(\".elementor-widget\");\n  if (anfitrion) anfitrion.classList.add(\"cumbre-banner-anfitrion\");\n  var marco = raiz.closest(\".e-con, .elementor-section, .elementor-column\") ||\n    raiz.parentElement;\n  marco.classList.add(\"cumbre-banner-marco\");\n\n  var duracion = 0;\n  var objetivo = 0.5;\n  var actual = 0.5;\n  var seekPendiente = null;\n  var movimientoReducido = window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n  var punteroFino = window.matchMedia(\"(pointer: fine)\").matches;\n\n  function capturarDuracion() {\n    if (isFinite(video.duration) && video.duration > 0) duracion = video.duration;\n  }\n  video.addEventListener(\"loadedmetadata\", function () {\n    capturarDuracion();\n    video.pause();\n    video.currentTime = movimientoReducido ? (duracion || reserva) / 2 : 0;\n  });\n  video.addEventListener(\"durationchange\", capturarDuracion);\n  video.addEventListener(\"canplay\", capturarDuracion);\n  // Cola de exactamente un seek pendiente: nunca más seeks de los que el\n  // decodificador puede atender.\n  video.addEventListener(\"seeked\", function () {\n    if (seekPendiente !== null) {\n      var t = seekPendiente;\n      seekPendiente = null;\n      video.currentTime = t;\n    }\n  });\n\n  function irAProgreso(progreso) {\n    var d = duracion || video.duration;\n    if (!d || !isFinite(d)) d = reserva;\n    var limitado = Math.max(0, Math.min(1, progreso));\n    var destino = limitado * Math.max(0, d - 0.05);\n    if (video.seeking) seekPendiente = destino;\n    else video.currentTime = destino;\n  }\n\n  if (!movimientoReducido && punteroFino) {\n    // El mouse solo fija un objetivo; un bucle rAF interpola con easing\n    // exponencial hacia él para que el scrub se sienta amortiguado.\n    marco.addEventListener(\"mousemove\", function (e) {\n      var caja = marco.getBoundingClientRect();\n      var pct = (e.clientX - caja.left) / caja.width;\n      objetivo = Math.max(0, Math.min(1, (pct - 0.1) / 0.8));\n    });\n    (function animar() {\n      var siguiente = actual + (objetivo - actual) * 0.09;\n      if (Math.abs(siguiente - actual) > 0.0004) {\n        actual = siguiente;\n        irAProgreso(siguiente);\n      }\n      requestAnimationFrame(animar);\n    })();\n  }\n\n  // Fundido de salida + scrub táctil, atados al scroll.\n  function alDesplazar() {\n    var caja = marco.getBoundingClientRect();\n    var progresoSalida = Math.max(0, Math.min(1, -caja.top / Math.max(1, caja.height)));\n    salida.style.opacity = String(\n      Math.max(0, Math.min(1, (progresoSalida - 0.2) / 0.7)),\n    );\n    if (!punteroFino && !movimientoReducido) irAProgreso(progresoSalida);\n  }\n  window.addEventListener(\"scroll\", alDesplazar, { passive: true });\n  alDesplazar();\n})();\n</script>\n"
     },
