   "elements": [
    {
     "id": "9fec8f32",
     "elType": "widget",
     "isInner": false,
     "settings": {
      "html": "<!-- ============================================================================\n  CUMBRE IA NARIÑO · CONTENIDO — vídeo scrubbeado con el scroll, para Elementor.\n\n  CÓMO USARLO:\n  1. En Elementor agrega un widget \"HTML\" y pega TODO este archivo. Colócalo\n     JUSTO ANTES de tus secciones de capítulos.\n  2. Crea tus capítulos como contenedores normales de Elementor (título,\n     texto, botones… lo que quieras) y a CADA UNO asígnale la clase CSS\n     \"cumbre-capitulo\" (Avanzado → Clases CSS). Puedes crear los que quieras,\n     en el orden que quieras: el vídeo se reparte en partes iguales entre ellos.\n  3. Deja los capítulos con fondo transparente para que el vídeo se vea detrás.\n  4. Cambia la URL del vídeo en data-video (MP4 directo H.264 sin audio; puede\n     venir de tu Biblioteca de medios).\n\n  El efecto: mientras el visitante recorre los capítulos, el vídeo queda fijo\n  a pantalla completa detrás del contenido y avanza/retrocede al ritmo del\n  scroll, con suavizado. Antes del primer capítulo y después del último, el\n  vídeo desaparece en fundido y no interfiere con el resto de la página.\n\n  Si NO agregas ninguna sección con clase \"cumbre-capitulo\", el widget crea\n  su propio recorrido de data-secciones × 100vh como demostración.\n============================================================================ -->\n<div class=\"cumbre-secuencia\"\n     data-video=\"/cumbre/videos/cumbre-secuencia.mp4\"\n     data-duracion-reserva=\"20\"\n     data-secciones=\"5\">\n  <div class=\"cumbre-secuencia__nucleo\"></div>\n  <video class=\"cumbre-secuencia__video\" muted playsinline preload=\"auto\" aria-hidden=\"true\"></video>\n  <div class=\"cumbre-secuencia__vineta\"></div>\n</div>\n\n<style>\n  .cumbre-secuencia{position:fixed;inset:0;z-index:1;opacity:0;pointer-events:none;\n    visibility:hidden;transition:visibility 0s linear .2s;}\n  .cumbre-secuencia.cumbre-secuencia--activa{visibility:visible;transition:none;}\n  .cumbre-secuencia__nucleo{position:absolute;inset:0;\n    background:radial-gradient(ellipse at center,#000a22 0%,#00133d 65%);}\n  .cumbre-secuencia__video{position:absolute;inset:0;width:100%;height:100%;\n    object-fit:cover;opacity:.95;mix-blend-mode:screen;}\n  .cumbre-secuencia__vineta{position:absolute;inset:0;\n    background:linear-gradient(to right,rgba(0,19,61,.85) 0%,transparent 35%,transparent 65%,rgba(0,19,61,.85) 100%);}\n  /* Los capítulos del usuario quedan por encima del vídeo fijo. */\n  .cumbre-capitulo{position:relative;z-index:2;min-height:100vh;}\n  .cumbre-secuencia__espaciador{height:0;}\n</style>\n\n<script>\n(function () {\n  \"use strict\";\n  var raiz = document.querySelector(\".cumbre-secuencia:not([data-listo])\");\n  if (!raiz) return;\n  raiz.setAttribute(\"data-listo\", \"1\");\n\n  var video = raiz.querySelector(\".cumbre-secuencia__video\");\n  var reserva = parseFloat(raiz.getAttribute(\"data-duracion-reserva\")) || 20;\n  var seccionesDemo = parseInt(raiz.getAttribute(\"data-secciones\"), 10) || 5;\n  video.src = raiz.getAttribute(\"data-video\");\n\n  var anfitrion = raiz.closest(\".elementor-widget\") || raiz;\n  var duracion = 0;\n  var objetivo = 0;\n  var actual = 0;\n  var seekPendiente = null;\n  var espaciador = null;\n  var movimientoReducido = window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n\n  function capturarDuracion() {\n    if (isFinite(video.duration) && video.duration > 0) duracion = video.duration;\n  }\n  video.addEventListener(\"loadedmetadata\", function () {\n    capturarDuracion();\n    video.pause();\n    video.currentTime = 0;\n  });\n  video.addEventListener(\"durationchange\", capturarDuracion);\n  video.addEventListener(\"canplay\", capturarDuracion);\n  video.addEventListener(\"seeked\", function () {\n    if (seekPendiente !== null) {\n      var t = seekPendiente;\n      seekPendiente = null;\n      video.currentTime = t;\n    }\n  });\n\n  function irAProgreso(progreso) {\n    var d = duracion || video.duration;\n    if (!d || !isFinite(d)) d = reserva;\n    var limitado = Math.max(0, Math.min(1, progreso));\n    var destino = limitado * Math.max(0, d - 0.05);\n    if (video.seeking) seekPendiente = destino;\n    else video.currentTime = destino;\n  }\n\n  function capitulos() {\n    return Array.prototype.slice.call(document.querySelectorAll(\".cumbre-capitulo\"));\n  }\n\n  // Sin capítulos del usuario, se crea un recorrido de demostración.\n  // Solo se decide con el DOM completo: este script corre antes de que las\n  // secciones que vienen después del widget existan.\n  var domListo = document.readyState !== \"loading\";\n  document.addEventListener(\"DOMContentLoaded\", function () {\n    domListo = true;\n    alDesplazar();\n  });\n  window.addEventListener(\"load\", function () { alDesplazar(); });\n\n  function asegurarRecorrido() {\n    if (capitulos().length > 0) {\n      if (espaciador) { espaciador.remove(); espaciador = null; }\n      return;\n    }\n    if (!domListo) return;\n    if (!espaciador) {\n      espaciador = document.createElement(\"div\");\n      espaciador.className = \"cumbre-secuencia__espaciador\";\n      anfitrion.parentNode.insertBefore(espaciador, anfitrion.nextSibling);\n    }\n    espaciador.style.height = seccionesDemo * 100 + \"vh\";\n  }\n\n  function rango() {\n    var caps = capitulos();\n    if (caps.length > 0) {\n      var inicio = Infinity;\n      var fin = -Infinity;\n      caps.forEach(function (c) {\n        var caja = c.getBoundingClientRect();\n        inicio = Math.min(inicio, caja.top + window.scrollY);\n        fin = Math.max(fin, caja.bottom + window.scrollY);\n      });\n      return { inicio: inicio, fin: fin };\n    }\n    var base = anfitrion.getBoundingClientRect().top + window.scrollY;\n    return { inicio: base, fin: base + seccionesDemo * window.innerHeight };\n  }\n\n  function alDesplazar() {\n    asegurarRecorrido();\n    var r = rango();\n    var alto = window.innerHeight;\n    var recorrido = Math.max(1, r.fin - r.inicio - alto);\n    var progreso = (window.scrollY - r.inicio) / recorrido;\n    objetivo = progreso;\n\n    // El vídeo solo es visible dentro del recorrido, con fundido en los bordes.\n    var dentro = progreso > -0.15 && progreso < 1.15;\n    raiz.classList.toggle(\"cumbre-secuencia--activa\", dentro);\n    var entrada = Math.max(0, Math.min(1, (progreso + 0.1) / 0.15));\n    var salida = Math.max(0, Math.min(1, (1.1 - progreso) / 0.15));\n    raiz.style.opacity = String(Math.min(entrada, salida));\n  }\n  window.addEventListener(\"scroll\", alDesplazar, { passive: true });\n  window.addEventListener(\"resize\", alDesplazar);\n\n  if (movimientoReducido) {\n    // Sin animación: un frame representativo según el capítulo visible.\n    window.addEventListener(\"scroll\", function () {\n      var n = capitulos().length || seccionesDemo;\n      var i = Math.max(0, Math.min(n - 1, Math.floor(objetivo * n)));\n      irAProgreso((i + 0.5) / n);\n    }, { passive: true });\n  } else {\n    // Suavizado tipo muelle: el scroll fija el objetivo y el bucle rAF\n    // interpola hacia él, drenando como mucho un seek por frame.\n    (function animar() {\n      var siguiente = actual + (objetivo - actual) * 0.11;\n      if (Math.abs(siguiente - actual) > 0.0004) {\n        actual = siguiente;\n        irAProgreso(siguiente);\n      }\n      requestAnimationFrame(animar);\n    })();\n  }\n  alDesplazar();\n})();\n</script>\n"
     },
     "elements": [],
     "widgetType": "html"
    }
   ]
  },
