     "id": "313ca599",
     "elType": "widget",
     "isInner": false,
     "settings": {
      "html": "<!-- Decoración de la sección de inscripción: rejilla, glow naranja y\npunto pulsante para la etiqueta. Pega este widget dentro del contenedor de la\nsección; el resto son widgets normales de Elementor. -->\n<div class=\"cumbre-inscripcion-decor\" aria-hidden=\"true\"></div>\n<style>\n  .cumbre-inscripcion-marco{position:relative!important;overflow:hidden;}\n  .cumbre-inscripcion-marco .elementor-widget:not(.cumbre-inscripcion-anfitrion){position:relative;z-index:2;}\n  .cumbre-inscripcion-decor{position:absolute;inset:0;pointer-events:none;z-index:0;}\n  .cumbre-inscripcion-decor::before{content:\"\";position:absolute;inset:0;opacity:.4;\n    background-size:50px 50px;\n    background-image:linear-gradient(to right,rgba(255,255,255,.04) 1px,transparent 1px),\n      linear-gradient(to bottom,rgba(255,255,255,.04) 1px,transparent 1px);}\n  .cumbre-inscripcion-decor::after{content:\"\";position:absolute;left:50%;top:50%;\n    width:480px;height:480px;transform:translate(-50%,-50%);border-radius:50%;\n    background:#FF6300;filter:blur(120px);opacity:.3;}\n  /* Punto pulsante delante de la etiqueta: asigna la clase CSS\n     \"cumbre-etiqueta-viva\" al widget de título de la etiqueta. */\n  .cumbre-etiqueta-viva .elementor-heading-title{display:inline-flex;align-items:center;gap:8px;}\n  .cumbre-etiqueta-viva .elementor-heading-title::before{content:\"\";width:6px;height:6px;\n    border-radius:50%;background:#FF6300;animation:cumbre-pulso 2s cubic-bezier(.4,0,.6,1) infinite;}\n  @keyframes cumbre-pulso{0%,100%{opacity:1}50%{opacity:.4}}\n  /* Botón píldora naranja reutilizable: clase \"cumbre-boton\" en el widget botón. */\n  .cumbre-boton .elementor-button{border-radius:999px;background:#FF6300;color:#00133D;\n    font-weight:700;transition:background .2s,color .2s;}\n  .cumbre-boton .elementor-button:hover{background:#8C0001;color:#fff;}\n</style>\n<script>\n(function(){\n  \"use strict\";\n  var d=document.querySelector(\".cumbre-inscripcion-decor:not([data-listo])\");\n  if(!d)return;\n  d.setAttribute(\"data-listo\",\"1\");\n  var w=d.closest(\".elementor-widget\");\n  if(w)w.classList.add(\"cumbre-inscripcion-anfitrion\");\n  var m=d.closest(\".e-con, .elementor-section, .elementor-column\")||d.parentElement;\n  m.classList.add(\"cumbre-inscripcion-marco\");\n})();\n</script>"
     },
