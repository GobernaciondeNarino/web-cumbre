# Sirve el build compilado (dist/) aunque el document root apunte a esta carpeta.
# Las reglas son relativas al directorio: funcionan igual con el repo en la raíz
# del dominio (httpdocs) o en cualquier subcarpeta (p. ej. httpdocs/cumbre).
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Lo que ya apunta dentro de dist/ se sirve tal cual (evita bucles).
  RewriteRule ^dist/ - [L]
  # Nunca exponer el código fuente ni la configuración.
  RewriteRule ^(wj-includes|wj-content|wj-admin|node_modules|\.claude|\.github|\.git)(/|$) dist/index.html [L]
  # Todo lo demás (/, /favicon.svg, /assets/*, /videos/*) se reescribe hacia dist/.
  RewriteRule ^(.*)$ dist/$1 [L]
</IfModule>
